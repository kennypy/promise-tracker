############################################################
# Promise Tracker — Self-Hosted Configuration
# Copy this to .env and fill in your values
############################################################

# ── DOMAIN ──────────────────────────────────────────────
# Your server's hostname (used by Nginx and Supabase)
SITE_DOMAIN=promises.example.com

# ── POSTGRES ────────────────────────────────────────────
POSTGRES_PASSWORD=your-super-secret-db-password
POSTGRES_DB=promise_tracker
POSTGRES_PORT=5432

# ── SUPABASE / JWT ──────────────────────────────────────
# Generate these with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Anon key — limited public access (used by the frontend)
# Generate at: https://supabase.com/docs/guides/self-hosting#api-keys
# Or use the setup.sh script which generates them automatically
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── SUPABASE SERVICES ──────────────────────────────────
# Internal URLs (Docker networking — don't change unless you know what you're doing)
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLIC_URL=https://promises.example.com

# ── GOTRUE (Auth) ───────────────────────────────────────
GOTRUE_SITE_URL=https://promises.example.com
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_SENDER_NAME="Promise Tracker"

# ── SUPABASE STUDIO (optional admin panel) ─────────────
STUDIO_PORT=3000
STUDIO_DEFAULT_ORGANIZATION="Promise Tracker"
STUDIO_DEFAULT_PROJECT=promise-tracker

# ── REALTIME ────────────────────────────────────────────
REALTIME_DB_HOST=db
REALTIME_DB_PORT=5432
REALTIME_DB_NAME=promise_tracker
REALTIME_DB_USER=supabase_admin
REALTIME_DB_PASSWORD=your-super-secret-db-password

# ── NGINX / TLS ─────────────────────────────────────────
# Set to "true" to enable Let's Encrypt auto-TLS via Caddy sidecar
ENABLE_TLS=false
LETSENCRYPT_EMAIL=admin@example.com
